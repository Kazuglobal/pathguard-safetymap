{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "copy-cesium": "node scripts/copy-cesium.js",
    "copy-mediapipe": "node scripts/copy-mediapipe.js",
    "predev": "node scripts/copy-cesium.js && node scripts/copy-mediapipe.js",
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev --webpack",
    "dev:turbo": "cross-env NEXT_DIST_DIR=.next-dev next dev",
    "build": "node scripts/copy-cesium.js && node scripts/copy-mediapipe.js && node scripts/validate-env.js && cross-env NODE_OPTIONS=--max-old-space-size=8192 DISABLE_ESLINT_PLUGIN=true next build --webpack",
    "build:cloudflare": "node scripts/cloudflare/build-free-workers.mjs",
    "preview:cloudflare": "node scripts/cloudflare/build-free-workers.mjs --skip-next-build && wrangler dev --config wrangler.jsonc",
    "deploy:cloudflare": "node scripts/cloudflare/deploy-free-workers.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pathguardian --local",
    "db:migrate:remote": "wrangler d1 migrations apply pathguardian --remote",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "validate-env": "node scripts/validate-env.js",
    "test-mapbox": "node scripts/test-mapbox-integration.js",
    "mcp-server": "npx -y @mapbox/mcp-server",
    "test-mcp": "node scripts/test-mcp-server.js",
    "deploy": "pnpm deploy:cloudflare",
    "deploy:preview": "pnpm preview:cloudflare",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "test:responsive": "playwright test tests/responsive",
    "test:responsive:headed": "playwright test tests/responsive --headed",
    "test:responsive:mobile": "playwright test tests/responsive --project='Mobile Chrome - iPhone 12'",
    "test:responsive:tablet": "playwright test tests/responsive --project='Tablet - iPad'",
    "test:responsive:desktop": "playwright test tests/responsive --project='Desktop - Chrome 1920x1080'",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "check:supabase-auth-only": "node scripts/check-supabase-auth-only.mjs",
    "migrate:pg-to-d1": "tsx scripts/migrate/pg-to-d1.ts",
    "migrate:split:traffic": "node scripts/migrate/split-traffic-d1.mjs",
    "migrate:hazards": "tsx scripts/import-hazard-zones.ts",
    "migrate:export:hazards": "tsx scripts/migrate/export-pg-hazards.ts",
    "migrate:import:hazard-plan": "tsx scripts/migrate/import-hazard-plan.ts",
    "migrate:verify": "tsx scripts/migrate/verify-cutover.ts",
    "migrate:benchmark:d1": "tsx scripts/migrate/benchmark-d1-bbox.ts",
    "migrate:backup:postgres": "pwsh -NoProfile -File scripts/migrate/backup-postgres.ps1",
    "migrate:backup:postgres:supabase-cli": "pwsh -NoProfile -File scripts/migrate/backup-postgres-via-supabase-cli.ps1",
    "migrate:backup:storage": "pwsh -NoProfile -File scripts/migrate/backup-storage.ps1",
    "migrate:backup:storage:wrangler": "tsx scripts/migrate/backup-storage-via-wrangler.ts",
    "migrate:sync:storage": "pwsh -NoProfile -File scripts/migrate/sync-storage.ps1",
    "migrate:sync:storage:wrangler": "tsx scripts/migrate/sync-storage-via-wrangler.ts",
    "provision:cloudflare": "pwsh -NoProfile -File scripts/migrate/provision-cloudflare.ps1",
    "configure:r2-delivery": "pwsh -NoProfile -File scripts/migrate/configure-r2-delivery.ps1",
    "create-test-users": "tsx scripts/create-test-users.ts",
    "pipeline:run": "tsx instagram-tiktok-agents/scripts/run-pipeline.ts",
    "pipeline:run:date": "tsx instagram-tiktok-agents/scripts/run-pipeline.ts",
    "generate-news-images": "tsx scripts/generate-school-route-news-images.ts",
    "generate-disaster-images": "tsx scripts/generate-disaster-prompt-images.ts"
  },
